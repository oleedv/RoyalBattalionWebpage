generator client {
  provider = "prisma-client"
  output   = "../packages/api/src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String          @id @default(cuid())
  discordId      String          @unique
  discordName    String
  displayName    String?
  steamId        String?         @unique
  eosId          String?         @unique
  avatarUrl      String?
  country        String?
  membershipDate DateTime?
  dateOfBirth     DateTime?
  birthdayOptOut  Boolean         @default(false)
  birthdayShowAge Boolean         @default(false)
  hasLoggedIn     Boolean         @default(false)
  disabled       Boolean         @default(false)
  disabledAt     DateTime?
  disabledReason String?         @db.Text
  roles               UserRole[]
  comments            MemberComment[]
  whitelistEntries    WhitelistEntry[]
  whitelistDismissals WhitelistRequestDismissal[]
  deletionRequests    DataDeletionRequest[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model MemberComment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([userId])
}

model DiscordRole {
  id              String           @id @default(cuid())
  discordRoleId   String           @unique
  name            String
  grantsWhitelist Boolean          @default(false)
  isMemberRole    Boolean          @default(false)
  permissions     RolePermission[]
  users           UserRole[]
}

model UserRole {
  id     String      @id @default(cuid())
  userId String
  roleId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   DiscordRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  id         String      @id @default(cuid())
  roleId     String
  permission String
  role       DiscordRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model AdminGroup {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  entries     WhitelistEntry[]
}

model Clan {
  id        String           @id @default(cuid())
  name      String           @unique
  tag       String           @unique
  createdAt DateTime         @default(now())
  entries   WhitelistEntry[]
}

model WhitelistEntry {
  id        String              @id @default(cuid())
  steamId   String
  server    String              @default("main")
  name      String?
  clan      String?
  clanId    String?
  clanRef   Clan?               @relation(fields: [clanId], references: [id], onDelete: SetNull)
  role      String?
  groupId   String?
  group     AdminGroup?         @relation(fields: [groupId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  addedBy   String
  reason    String?
  expiresAt     DateTime?
  deactivatedAt DateTime?           // set only by member-disable; null = active
  createdAt DateTime            @default(now())
  comments  WhitelistComment[]

  @@unique([steamId, server])
  @@index([server])
  @@index([expiresAt])
  @@index([deactivatedAt])
  @@index([clanId])
  @@index([groupId])
  @@index([userId])
  @@index([steamId])
}

model WhitelistComment {
  id               String         @id @default(cuid())
  whitelistEntryId String
  whitelistEntry   WhitelistEntry @relation(fields: [whitelistEntryId], references: [id], onDelete: Cascade)
  authorId         String
  authorName       String
  text             String         @db.Text
  createdAt        DateTime       @default(now())

  @@index([whitelistEntryId])
}

/// Staff dismiss of a computed whitelist request. Unique per (user, server).
/// Active while restoredAt is null and expiresAt is in the future (30 days).
model WhitelistRequestDismissal {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  server          String
  dismissedBy     String
  dismissedByName String
  reason          String?
  dismissedAt     DateTime  @default(now())
  expiresAt       DateTime
  restoredAt      DateTime?

  @@unique([userId, server])
  @@index([server, expiresAt])
  @@index([userId])
}

model ServerConfig {
  id          String  @id @default(cuid())
  server      String  @unique
  label       String
  sftpHost    String?
  sftpPort    Int     @default(22)
  sftpUser    String?
  sftpPass    String?
  sftpPath    String?
  syncEnabled Boolean @default(false)
}

model Match {
  id          String   @id @default(cuid())
  squadjsId   Int?     @unique
  date        DateTime
  map         String
  layer       String
  result      String
  server      String   @default("Main Server")
  vodUrl      String?
  hidden      Boolean  @default(false)
  matchDetail Json?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userName   String
  action     String
  resource   String
  resourceId String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([resource])
}

/// Queue of account-deletion requests from signed-in members.
/// Developers handle these by hand; the row is a notice, not an auto-delete.
model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  discordId   String
  discordName String
  displayName String?
  steamId     String?
  status      String    @default("pending")
  handledAt   DateTime?
  handledBy   String?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([userId])
}

/// Singleton (single row, id = "singleton") controlling the Discord birthday
/// announcer. Read by the bot via its optional `website` pool; written by the
/// webpage via the normal Prisma client. postTime is "HH:MM" 24h.
model BirthdayConfig {
  id        String  @id @default("singleton")
  enabled   Boolean @default(false)
  channelId String?
  postTime  String  @default("09:00")
  timezone  String  @default("Europe/Oslo")
  updatedAt DateTime @updatedAt
}
