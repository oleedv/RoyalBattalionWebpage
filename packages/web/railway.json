{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "packages/web/Dockerfile",
    "buildArgs": {
      "NEXT_PUBLIC_API_URL": "${{NEXT_PUBLIC_API_URL}}"
    }
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
