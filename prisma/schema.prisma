generator client {
  provider = "prisma-client"
  output   = "../packages/api/src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String     @id @default(cuid())
  discordId   String     @unique
  discordName String
  steamId     String?    @unique
  eosId       String?    @unique
  avatarUrl   String?
  roles       UserRole[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DiscordRole {
  id              String           @id @default(cuid())
  discordRoleId   String           @unique
  name            String
  grantsWhitelist Boolean          @default(false)
  permissions     RolePermission[]
  users           UserRole[]
}

model UserRole {
  id     String      @id @default(cuid())
  userId String
  roleId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   DiscordRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id         String      @id @default(cuid())
  roleId     String
  permission String
  role       DiscordRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permission])
}

model AdminGroup {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions String
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  entries     WhitelistEntry[]
}

model WhitelistEntry {
  id        String      @id @default(cuid())
  steamId   String
  server    String      @default("main")
  name      String?
  clan      String?
  role      String?
  groupId   String?
  group     AdminGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  addedBy   String
  reason    String?
  expiresAt DateTime?
  createdAt DateTime    @default(now())

  @@unique([steamId, server])
}

model ServerConfig {
  id          String  @id @default(cuid())
  server      String  @unique
  label       String
  sftpHost    String?
  sftpPort    Int     @default(22)
  sftpUser    String?
  sftpPass    String?
  sftpPath    String?
  syncEnabled Boolean @default(true)
}

model Match {
  id          String   @id @default(cuid())
  squadjsId   Int?     @unique
  date        DateTime
  map         String
  layer       String
  result      String
  server      String   @default("Main Server")
  vodUrl      String?
  hidden      Boolean  @default(false)
  matchDetail Json?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
